{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "game/serve.js",
        "1337"
      ],
      "port": 1337
    },
    {
      "name": "server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release",
        "--bin",
        "server",
        "--manifest-path",
        "server/Cargo.toml",
        "--",
        "--spawns",
        "game/data/mobspawns.json",
        "--weapons",
        "game/data/weapons.json",
        "--pois",
        "game/data/pois.json",
        "--capitals",
        "game/data/spawns.json",
        "--npcs",
        "500",
        "--port",
        "1399",
        "--nav",
        "server/data/nav",
        "--db",
        "none",
        "--accounts",
        "server/accounts.db",
        "--items",
        "game/data/items.json",
        "--vendors",
        "game/data/vendors.json"
      ],
      "port": 1399
    },
    {
      "name": "game-npc",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "game/serve.js",
        "1340"
      ],
      "port": 1340
    }
  ]
}
